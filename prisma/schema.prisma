generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ═══════════════════════════════════════════════════════════════════
// 1. AUTHENTICATION & MULTI-TENANT USER MANAGEMENT
// ═══════════════════════════════════════════════════════════════════

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  majorOrField String?  @default("Đa ngành")
  avatar       String?
  role         String   @default("USER") // USER, ADMIN
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Auth Sessions
  sessions AuthSession[]

  // Core Productivity & Calendar
  tasks            Task[]
  sprints          Sprint[]
  smartGoals       SmartGoal[]
  deepWorkSessions DeepWorkSession[]

  // Health, Fitness & Nutrition
  workouts      Workout[]
  bodyMetrics   BodyMetric[]
  pantryItems   PantryItem[]
  recipes       Recipe[]
  nutritionLogs NutritionLog[]
  sleepLogs     SleepLog[]
  bioCycles     BioCycle[]
  settings      UserSettings?

  // Finance
  transactions    FinancialTransaction[]
  inventoryItems  InventoryItem[]
  subscriptions   Subscription[]
  impulseBuyItems ImpulseBuyItem[]
  budgets         Budget[]
  savingsGoals    SavingsGoal[]

  // Career & Learning
  skills          Skill[]
  skillProfiles   UserSkillProfile[]
  flashcardDecks  FlashcardDeck[]
  quizHistories   QuizHistory[]
  jobApplications JobApplication[]
  codeSnippets    CodeSnippet[]
  subjectGroups   SubjectGroup[]

  // Mental, CRM & Memory
  moodLogs            MoodLog[]
  detoxSessions       DetoxSession[]
  informationDietLogs InformationDietLog[]
  contacts            Contact[]
  memories            MemoryVault[]
  brainDumps          BrainDump[]
}

model AuthSession {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

// ═══════════════════════════════════════════════════════════════════
// 2. HEALTH, FITNESS & NUTRITION MODELS
// ═══════════════════════════════════════════════════════════════════

model Workout {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  title     String
  type      String
  duration  Int
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
}

model BodyMetric {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  weight    Float?
  bodyFat   Float?
  chest     Float?
  waist     Float?
  hips      Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
}

model PantryItem {
  id        String    @id @default(cuid())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  category  String?
  quantity  String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
}

model Recipe {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  ingredients  String
  instructions String
  calories     Int?
  prepTime     Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model NutritionLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime @default(now())
  calories   Int      @default(0)
  protein    Int      @default(0)
  carbs      Int      @default(0)
  fat        Int      @default(0)
  budgetUsed Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, date])
}

model SleepLog {
  id           String    @id @default(cuid())
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime  @default(now())
  sleepTime    DateTime
  wakeTime     DateTime?
  qualityScore Int?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId, date])
}

model BioCycle {
  id                     String    @id @default(cuid())
  userId                 String?
  user                   User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate              DateTime
  endDate                DateTime?
  cycleLength            Int?
  predictedLowEnergyDate DateTime?
  waterRetentionDays     String?
  notes                  String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([userId])
}

model UserSettings {
  id              String    @id @default("default")
  userId          String?   @unique
  user            User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bodyRecompGoal  String    @default("Cài đặt mục tiêu cân nặng")
  goalCal         Int       @default(1500)
  budgetGoal      Float     @default(400000)
  hydrationGoal   Int       @default(8)
  fastingStart    DateTime?
  activeBlueprint String?
  updatedAt       DateTime  @updatedAt
}

// ═══════════════════════════════════════════════════════════════════
// 3. CALENDAR, SCHEDULE, TASKS, SPRINTS & SMART GOALS
// ═══════════════════════════════════════════════════════════════════

model Sprint {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)
  tasks     Task[]

  @@index([userId, isActive])
}

model Task {
  id          String    @id @default(cuid())
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  category    String    @default("SCHEDULE") // SCHEDULE, TIMETABLE, WORK_SCHEDULE, APPOINTMENT, TASK
  location    String?
  energyLevel String
  status      String    @default("TODO")
  startTime   DateTime  @default(now())
  deadline    DateTime
  completedAt DateTime?
  overdueNote String?
  timeSpent   Int       @default(0)
  sprintId    String?
  sprint      Sprint?   @relation(fields: [sprintId], references: [id])
  isCoreTask  Boolean   @default(false)
  blockedById String?
  blockedBy   Task?     @relation("TaskDependencies", fields: [blockedById], references: [id])
  blocking    Task[]    @relation("TaskDependencies")
  createdAt   DateTime  @default(now())

  @@index([userId, status])
  @@index([userId, startTime, deadline])
}

model SmartGoal {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  category     String   @default("Personal")
  specific     String
  measurable   String
  currentValue Float    @default(0)
  targetValue  Float    @default(100)
  unit         String   @default("%")
  achievable   String
  relevant     String
  startDate    DateTime @default(now())
  deadline     DateTime
  status       String   @default("IN_PROGRESS")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, deadline])
}

model DeepWorkSession {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  duration  Int
  taskName  String?
  flowState Int?
  createdAt DateTime @default(now())

  @@index([userId, date])
}

// ═══════════════════════════════════════════════════════════════════
// 4. FINANCE, INVENTORY & SUBSCRIPTIONS
// ═══════════════════════════════════════════════════════════════════

model FinancialTransaction {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Float
  category  String
  type      String   // income or expense
  date      DateTime @default(now())
  notes     String?
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model InventoryItem {
  id         String    @id @default(cuid())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  cost       Float
  uses       Int       @default(0)
  openedAt   DateTime?
  expiryDays Int?
  paoMonths  Int?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Subscription {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  cost        Float
  renewalDate DateTime
  frequency   String
  createdAt   DateTime @default(now())

  @@index([userId])
}

model Budget {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     String
  monthlyLimit Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model SavingsGoal {
  id           String    @id @default(cuid())
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  targetAmount Float
  savedAmount  Float     @default(0)
  deadline     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
}

model ImpulseBuyItem {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  price     Float
  status    String   @default("WAITING")
  addedAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ═══════════════════════════════════════════════════════════════════
// 5. MENTAL WELLBEING, CRM & MEMORY VAULT
// ═══════════════════════════════════════════════════════════════════

model MoodLog {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime @default(now())
  energy        Int
  mood          Int
  notes         String?
  socialBattery Int?
  hydration     Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([userId, date])
}

model DetoxSession {
  id        String    @id @default(cuid())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate DateTime  @default(now())
  endDate   DateTime?
  success   Boolean   @default(false)
  notes     String?

  @@index([userId])
}

model InformationDietLog {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime @default(now())
  junkTime     Int
  valuableTime Int
  notes        String?
  createdAt    DateTime @default(now())

  @@index([userId, date])
}

model Contact {
  id            String        @id @default(cuid())
  userId        String?
  user          User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  category      String
  notes         String?
  valueExchange Int           @default(0)
  lastContact   DateTime      @default(now())
  createdAt     DateTime      @default(now())
  interactions  Interaction[]

  @@index([userId])
}

model Interaction {
  id         String   @id @default(cuid())
  date       DateTime @default(now())
  notes      String
  type       String   @default("meeting")
  valueGiven Boolean  @default(false)
  contactId  String
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
}

model MemoryVault {
  id            String    @id @default(cuid())
  userId        String?
  user          User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime  @default(now())
  content       String
  mediaUrls     String?
  tags          String?
  isTimeCapsule Boolean   @default(false)
  unlockDate    DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId, date])
}

model BrainDump {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())

  @@index([userId])
}

// ═══════════════════════════════════════════════════════════════════
// 6. CAREER, SKILLS & CURRICULUM VAULT
// ═══════════════════════════════════════════════════════════════════

model Skill {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  category  String
  exp       Int      @default(0)
  level     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model FlashcardDeck {
  id          String      @id @default(cuid())
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  category    String      @default("General")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  cards       Flashcard[]

  @@index([userId])
}

model Flashcard {
  id         String        @id @default(cuid())
  front      String
  back       String
  mastery    Int           @default(0)
  nextReview DateTime      @default(now())
  interval   Int           @default(0)
  deckId     String
  deck       FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model QuizHistory {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId    String
  questionText  String
  userAnswer    String
  isCorrect     Boolean
  skillCategory String?
  createdAt     DateTime @default(now())

  @@index([userId])
}

model UserSkillProfile {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillName  String   @unique
  level      Int      @default(1)
  exp        Int      @default(0)
  strengths  String?
  weaknesses String?
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model JobApplication {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company     String
  position    String
  status      String   @default("CV_SENT")
  appliedDate DateTime @default(now())
  notes       String?
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model CodeSnippet {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  language  String   @default("typescript")
  code      String
  tags      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model SubjectGroup {
  id        String    @id @default(cuid())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  icon      String
  color     String
  order     Int       @default(0)
  subjects  Subject[]
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Subject {
  id        String          @id @default(cuid())
  code      String
  name      String
  credits   Int             @default(3)
  icon      String
  color     String
  order     Int             @default(0)
  groupId   String
  group     SubjectGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  theories  TheorySection[]
  exercises Exercise[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model TheorySection {
  id                    String       @id @default(cuid())
  title                 String
  order                 Int          @default(0)
  coreConcept           String
  codeIllustrations     String?
  realWorldApplications String?
  edgeCases             String?
  flashcards            String?
  rating                Int?
  subjectId             String
  subject               Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  exercises             Exercise[]
  quizzes               ReviewQuiz[]
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
}

model Exercise {
  id                  String             @id @default(cuid())
  title               String
  difficulty          String             @default("Medium")
  hint                String?
  description         String
  realWorldScenario   String?
  edgeCasesToConsider String?
  starterCode         String
  testCases           ExerciseTestCase[]
  subjectId           String
  subject             Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  sectionId           String?
  section             TheorySection?     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

model ExerciseTestCase {
  id             String   @id @default(cuid())
  input          String
  expectedOutput String
  isHidden       Boolean  @default(false)
  exerciseId     String
  exercise       Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
}

model ReviewQuiz {
  id          String         @id @default(cuid())
  topic       String
  question    String
  options     String
  answerIndex Int
  explanation String
  difficulty  String         @default("Easy")
  sectionId   String?
  section     TheorySection? @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
}
